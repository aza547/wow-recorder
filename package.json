{
  "name": "WarcraftRecorder",
  "description": "Warcraft Recorder",
  "keywords": [
    "world",
    "of",
    "warcraft",
    "screen",
    "recorder"
  ],
  "homepage": "https://www.warcraftrecorder.com/",
  "bugs": {
    "url": "https://github.com/aza547/wow-recorder/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aza547/wow-recorder.git"
  },
  "license": "Creative Commons Attribution-NonCommercial",
  "author": {
    "name": "Alex K",
    "email": "warcraftrecorder@gmail.com",
    "url": "https://www.warcraftrecorder.com/"
  },
  "main": "./release/app/dist/main/main.js",
  "scripts": {
    "build": "electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "lint": "cross-env NODE_ENV=development eslint ./src",
    "lint:fix": "cross-env NODE_ENV=development eslint ./src --fix",
    "package": "ts-node ./.erb/scripts/clean.js && npm run build && electron-builder build --publish never",
    "preview": "electron-vite preview",
    "rebuild": "electron-rebuild --parallel --types prod,dev,optional --module-dir release/app",
    "start": "electron-vite dev --watch",
    "test": "jest --coverage --silent"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=14.x",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": ">=7.x",
      "onFail": "error"
    }
  },
  "build": {
    "productName": "WarcraftRecorder",
    "appId": "org.WarcraftRecorder",
    "asar": true,
    "asarUnpack": "**\\**",
    "files": [
      "dist",
      "node_modules",
      "package.json"
    ],
    "nsis": {
      "oneClick": true,
      "include": "installer.nsh",
      "deleteAppDataOnUninstall": true
    },
    "win": {
      "icon": "assets/icon.png",
      "signtoolOptions": {
        "certificateSubjectName": "Warcraft Recorder LTD"
      },
      "artifactName": "WarcraftRecorder-Setup-${version}.exe",
      "target": [
        "nsis"
      ]
    },
    "directories": {
      "app": "release/app",
      "buildResources": "assets",
      "output": "release/build"
    },
    "extraResources": [
      "./assets/**",
      "./binaries/*"
    ],
    "publish": {
      "provider": "github",
      "owner": "aza547",
      "repo": "wow-recorder"
    }
  },
  "jest": {
    "moduleDirectories": [
      "node_modules",
      "<rootDir>/src"
    ],
    "transform": {
      "\\.(ts|tsx|js|jsx)$": "ts-jest"
    }
  },
  "dependencies": {
    "@electron/notarize": "^3.0.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@excalidraw/excalidraw": "^0.18.1",
    "@fortawesome/fontawesome-svg-core": "^6.6.0",
    "@fortawesome/free-brands-svg-icons": "^6.6.0",
    "@fortawesome/free-regular-svg-icons": "^6.6.0",
    "@fortawesome/free-solid-svg-icons": "^6.6.0",
    "@fortawesome/react-fontawesome": "^0.2.2",
    "@mui/icons-material": "^5.8.4",
    "@mui/material": "^5.6.4",
    "@radix-ui/react-dialog": "^1.1.17",
    "@radix-ui/react-hover-card": "^1.1.17",
    "@radix-ui/react-label": "^2.1.10",
    "@radix-ui/react-popover": "^1.1.17",
    "@radix-ui/react-progress": "^1.1.10",
    "@radix-ui/react-scroll-area": "^1.2.12",
    "@radix-ui/react-select": "^2.3.1",
    "@radix-ui/react-separator": "^1.1.10",
    "@radix-ui/react-slider": "^1.4.1",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-switch": "^1.3.1",
    "@radix-ui/react-tabs": "^1.1.15",
    "@radix-ui/react-toast": "^1.2.17",
    "@radix-ui/react-toggle": "^1.1.12",
    "@radix-ui/react-toggle-group": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.10",
    "@tanstack/react-query": "^5.90.7",
    "@tanstack/react-table": "^9.0.0",
    "archiver": "^8.0.0",
    "atomic-queue": "^5.0.4",
    "axios": "^1.17.0",
    "check-disk-space": "^3.4.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.0",
    "dayjs": "^1.11.12",
    "electron-debug": "^4.1.0",
    "electron-log": "^5.4.4",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.9",
    "fluent-ffmpeg": "^2.1.2",
    "fs": "^0.0.1-security",
    "history": "^5.3.0",
    "lodash": "^4.17.21",
    "lucide-react": "^1.69.0",
    "node-abi": "^4.37.0",
    "path": "^0.12.7",
    "re-resizable": "^6.9.11",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-error-boundary": "^5.0.0",
    "react-player": "^3.4.0",
    "react-router-dom": "^7.3.0",
    "react-tag-autocomplete": "^7.5.0",
    "react-tailwindcss-datepicker": "^2.0.0",
    "roughjs": "^4.6.6",
    "screenfull": "^6.0.2",
    "semver": "^7.8.5",
    "tailwind-merge": "^2.5.2",
    "tailwindcss-animate": "^1.0.7",
    "tsc": "^2.0.4",
    "tss-react": "^4.1.1",
    "uuid": "^11.0.3",
    "wait-queue": "^1.1.4",
    "ws": "^8.18.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@electron/rebuild": "^4.0.4",
    "@eslint/js": "^9.17.0",
    "@rolldown/plugin-babel": "^0.3.0",
    "@testing-library/jest-dom": "^6.1.3",
    "@testing-library/react": "^16.2.0",
    "@types/archiver": "^8.0.0",
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/jest": "^29.5.5",
    "@types/lodash": "^4.17.13",
    "@types/node": "^26.1.1",
    "@types/react": "^19.0.11",
    "@types/react-dom": "^19.0.4",
    "@types/react-test-renderer": "^19.0.0",
    "@types/semver": "^7.7.1",
    "@vitejs/plugin-react": "^6.2.1",
    "autoprefixer": "^10.4.21",
    "babel-plugin-react-compiler": "^1.0.0",
    "browserslist": "^4.28.2",
    "browserslist-config-erb": "^0.0.3",
    "chalk": "^4.1.2",
    "cross-env": "^7.0.3",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-devtools-installer": "^4.0.0",
    "electron-notarize": "^1.2.2",
    "electron-to-chromium": "^1.5.478",
    "electron-vite": "^6.0.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^15.14.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "postcss": "^8.5.3",
    "prettier": "3.4.2",
    "react-test-renderer": "^19.0.0",
    "rimraf": "^5.0.1",
    "sass": "^1.86.0",
    "tailwindcss": "^3.4.10",
    "ts-jest": "^29.2.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.19.0",
    "vite": "^8.3.6"
  },
  "browserslist": [
    "extends browserslist-config-erb"
  ],
  "prettier": {
    "singleQuote": true,
    "overrides": [
      {
        "files": [
          ".prettierrc",
          ".eslintrc"
        ],
        "options": {
          "parser": "json"
        }
      }
    ]
  },
  "allowScripts": {
    "electron@45.2.3": true,
    "electron-winstaller@5.4.0": true
  }
}
